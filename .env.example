# ── Database (Postgres) ──────────────────────────────────────────────────────
# Runtime uses the POOLED connection string (PgBouncer / Neon "-pooler" host).
# DIRECT_URL is the non-pooled connection, used only by `prisma db push`/migrate.
# Neon: copy both from the dashboard. Supabase: pooled = port 6543, direct = 5432.
DATABASE_URL="postgresql://USER:PASS@HOST-pooler/db?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST/db?sslmode=require"

# ── LLM provider ────────────────────────────────────────────────────────────
# Server-side only. Adapter selects the provider; "anthropic" is the default.
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Optional — defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── Integrations ────────────────────────────────────────────────────────────
# n8n webhook that fans results out to Google Sheets + WhatsApp (Evolution API).
N8N_WEBHOOK_URL=""

# Public base URL (used for absolute OG/social image URLs). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Admin / room view ───────────────────────────────────────────────────────
# Gate for /room aggregate big-screen view.
ADMIN_KEY="change-me"
